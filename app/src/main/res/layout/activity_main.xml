<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/win_bg">

        <!-- Toolbar with navigation controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:background="@color/win_toolbar">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open menu"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu_vector"
                    android:tint="@color/win_text_secondary" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/win_input_bg"
                    android:hint="Search or address"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/win_text"
                    android:textColorHint="@color/win_text_secondary" />

                <ImageButton
                    android:id="@+id/goButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Go to URL"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_forward_vector"
                    android:tint="@color/win_accent" />

                <ImageButton
                    android:id="@+id/tabsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tabs"
                    android:padding="8dp"
                    android:src="@drawable/ic_tabs_vector"
                    android:tint="@color/win_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/homeButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Go home" android:padding="8dp" android:src="@drawable/ic_home_vector" android:tint="@color/win_text_secondary" />
                <ImageButton android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Go back" android:padding="8dp" android:src="@drawable/ic_back_vector" android:tint="@color/win_text_secondary" />
                <ImageButton android:id="@+id/forwardButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Go forward" android:padding="8dp" android:src="@drawable/ic_forward_vector" android:tint="@color/win_text_secondary" />
                <ImageButton android:id="@+id/refreshButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Refresh page" android:padding="8dp" android:src="@drawable/ic_refresh_vector" android:tint="@color/win_text_secondary" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageButton android:id="@+id/bookmarkButton" android:layout_width="40dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Add or remove bookmark" android:padding="8dp" android:src="@drawable/ic_bookmark_vector" android:tint="@color/win_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress bar for loading indication -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/win_accent"
            android:visibility="gone" />

        <!-- Main WebView - takes remaining space -->
        <org.mozilla.geckoview.GeckoView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/win_surface"
        android:layout_gravity="start"
        app:itemIconTint="@color/win_text"
        app:itemTextColor="@color/win_text"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
