<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textColor="@color/win_text"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/siteNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/win_input_bg"
        android:padding="8dp"
        android:hint="Site name"
        android:textColor="@color/win_text"
        android:textColorHint="@color/win_text_secondary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URL"
        android:textColor="@color/win_text"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/siteUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/win_input_bg"
        android:padding="8dp"
        android:hint="https://example.com"
        android:inputType="textUri"
        android:textColor="@color/win_text"
        android:textColorHint="@color/win_text_secondary" />
</LinearLayout>
